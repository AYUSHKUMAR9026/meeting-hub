{
  "openapi": "3.1.0",
  "info": {
    "title": "Meeting Hub API",
    "version": "0.1.0",
    "description": "Meeting Hub platform API. Errors use application/problem+json (RFC 9457)."
  },
  "components": {
    "schemas": {
      "ProblemInput": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "description": "URI reference identifying the problem type"
          },
          "title": {
            "type": "string"
          },
          "status": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          },
          "code": {
            "type": "string",
            "description": "Stable machine-readable error code, e.g. VALIDATION_FAILED"
          },
          "detail": {
            "type": "string"
          },
          "instance": {
            "type": "string"
          },
          "requestId": {
            "type": "string"
          },
          "errors": {
            "description": "Field-level validation errors",
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "path": {
                  "type": "string"
                },
                "message": {
                  "type": "string"
                }
              },
              "required": [
                "path",
                "message"
              ]
            }
          }
        },
        "required": [
          "type",
          "title",
          "status",
          "code"
        ]
      },
      "HealthResponseInput": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "const": "ok"
          },
          "uptimeSeconds": {
            "type": "number"
          }
        },
        "required": [
          "status",
          "uptimeSeconds"
        ]
      },
      "DependencyCheckInput": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "up",
              "down"
            ]
          },
          "latencyMs": {
            "type": "number"
          },
          "error": {
            "type": "string"
          }
        },
        "required": [
          "status",
          "latencyMs"
        ]
      },
      "ReadyResponseInput": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ready",
              "not_ready"
            ]
          },
          "checks": {
            "type": "object",
            "properties": {
              "postgres": {
                "$ref": "#/components/schemas/DependencyCheckInput"
              },
              "redis": {
                "$ref": "#/components/schemas/DependencyCheckInput"
              },
              "s3": {
                "$ref": "#/components/schemas/DependencyCheckInput"
              }
            },
            "required": [
              "postgres",
              "redis",
              "s3"
            ]
          }
        },
        "required": [
          "status",
          "checks"
        ]
      },
      "EvaluatedFlagInput": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string"
          },
          "enabled": {
            "type": "boolean"
          },
          "source": {
            "type": "string",
            "enum": [
              "override",
              "database",
              "default"
            ]
          }
        },
        "required": [
          "key",
          "enabled",
          "source"
        ]
      },
      "FlagsResponseInput": {
        "type": "object",
        "properties": {
          "flags": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/EvaluatedFlagInput"
            }
          }
        },
        "required": [
          "flags"
        ]
      },
      "Problem": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "description": "URI reference identifying the problem type"
          },
          "title": {
            "type": "string"
          },
          "status": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          },
          "code": {
            "type": "string",
            "description": "Stable machine-readable error code, e.g. VALIDATION_FAILED"
          },
          "detail": {
            "type": "string"
          },
          "instance": {
            "type": "string"
          },
          "requestId": {
            "type": "string"
          },
          "errors": {
            "description": "Field-level validation errors",
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "path": {
                  "type": "string"
                },
                "message": {
                  "type": "string"
                }
              },
              "required": [
                "path",
                "message"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "type",
          "title",
          "status",
          "code"
        ],
        "additionalProperties": false
      },
      "HealthResponse": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "const": "ok"
          },
          "uptimeSeconds": {
            "type": "number"
          }
        },
        "required": [
          "status",
          "uptimeSeconds"
        ],
        "additionalProperties": false
      },
      "DependencyCheck": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "up",
              "down"
            ]
          },
          "latencyMs": {
            "type": "number"
          },
          "error": {
            "type": "string"
          }
        },
        "required": [
          "status",
          "latencyMs"
        ],
        "additionalProperties": false
      },
      "ReadyResponse": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ready",
              "not_ready"
            ]
          },
          "checks": {
            "type": "object",
            "properties": {
              "postgres": {
                "$ref": "#/components/schemas/DependencyCheck"
              },
              "redis": {
                "$ref": "#/components/schemas/DependencyCheck"
              },
              "s3": {
                "$ref": "#/components/schemas/DependencyCheck"
              }
            },
            "required": [
              "postgres",
              "redis",
              "s3"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "status",
          "checks"
        ],
        "additionalProperties": false
      },
      "EvaluatedFlag": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string"
          },
          "enabled": {
            "type": "boolean"
          },
          "source": {
            "type": "string",
            "enum": [
              "override",
              "database",
              "default"
            ]
          }
        },
        "required": [
          "key",
          "enabled",
          "source"
        ],
        "additionalProperties": false
      },
      "FlagsResponse": {
        "type": "object",
        "properties": {
          "flags": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/EvaluatedFlag"
            }
          }
        },
        "required": [
          "flags"
        ],
        "additionalProperties": false
      }
    }
  },
  "paths": {
    "/health": {
      "get": {
        "summary": "Liveness probe",
        "tags": [
          "system"
        ],
        "description": "Cheap check that the process is up. Never touches dependencies.",
        "responses": {
          "200": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/ready": {
      "get": {
        "summary": "Readiness probe",
        "tags": [
          "system"
        ],
        "description": "Checks Postgres, Redis and S3. Returns 503 if any dependency is down.",
        "responses": {
          "200": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadyResponse"
                }
              }
            }
          },
          "503": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadyResponse"
                }
              }
            }
          }
        }
      }
    },
    "/v1/system/flags": {
      "get": {
        "summary": "Evaluated feature flags (development only)",
        "tags": [
          "system"
        ],
        "responses": {
          "200": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FlagsResponse"
                }
              }
            }
          },
          "500": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    }
  },
  "tags": [
    {
      "name": "system",
      "description": "Health, readiness and platform introspection"
    }
  ]
}
