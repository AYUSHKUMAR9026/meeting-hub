{
  "name": "meeting-hub",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.8.1",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=12.0.0"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:integration": "turbo run test:integration --concurrency=1",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "infra:up": "docker compose -f infra/docker-compose.yml up -d --wait postgres redis garage mailpit && docker compose -f infra/docker-compose.yml run --rm garage-init",
    "infra:down": "docker compose -f infra/docker-compose.yml down",
    "infra:reset": "docker compose -f infra/docker-compose.yml down -v",
    "db:generate": "pnpm --filter @meeting-hub/db generate",
    "db:migrate": "pnpm --filter @meeting-hub/db migrate",
    "db:studio": "pnpm --filter @meeting-hub/db studio",
    "openapi:export": "pnpm --filter @meeting-hub/server openapi:export && pnpm --filter @meeting-hub/web api:generate",
    "test:e2e": "pnpm --filter @meeting-hub/web test:e2e"
  },
  "devDependencies": {
    "@meeting-hub/config": "workspace:*",
    "prettier": "3.9.9",
    "turbo": "2.11.6",
    "typescript": "6.0.3",
    "eslint": "10.11.0"
  }
}
