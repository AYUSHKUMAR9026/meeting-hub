# Meeting Hub — environment variables.
# Copy to `.env` at the repo root: `cp .env.example .env`.
# Every value below is a LOCAL DEVELOPMENT default that matches infra/docker-compose.yml.
# Never commit a real .env; production values come from the deployment's secret store.

# ---------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------
# development | test | production. Controls pretty logs, OpenAPI exposure, error detail.
NODE_ENV=development
# pino level: fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# ---------------------------------------------------------------------------
# API server (apps/server, src/api.ts)
# ---------------------------------------------------------------------------
# Interface and port the API listens on.
API_HOST=0.0.0.0
API_PORT=4000
# Single browser origin allowed by CORS (the Next.js app).
WEB_ORIGIN=http://localhost:3000
# Max time (ms) to drain in-flight requests / jobs on SIGTERM before forcing exit.
SHUTDOWN_TIMEOUT_MS=10000

# ---------------------------------------------------------------------------
# PostgreSQL (with pgvector)
# ---------------------------------------------------------------------------
DATABASE_URL=postgres://meeting_hub:meeting_hub@localhost:5432/meeting_hub
# Max connections in each process's pool.
DATABASE_POOL_MAX=10

# ---------------------------------------------------------------------------
# Redis (BullMQ)
# ---------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379

# ---------------------------------------------------------------------------
# S3-compatible object storage (Garage locally)
# ---------------------------------------------------------------------------
S3_ENDPOINT=http://localhost:3900
S3_REGION=garage
S3_BUCKET=meeting-hub-dev
# Dev-only key imported into the local Garage by infra/garage/init.sh.
S3_ACCESS_KEY_ID=GK0123456789abcdef01234567
S3_SECRET_ACCESS_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
# Path-style URLs (http://host/bucket/key) — required for Garage and most self-hosted S3.
S3_FORCE_PATH_STYLE=true

# ---------------------------------------------------------------------------
# Feature flags
# ---------------------------------------------------------------------------
# Comma-separated overrides that win over the database, e.g. "flag.a=true,flag.b=false".
FEATURE_FLAGS_OVERRIDE=
# How long (ms) flags read from the database are cached in memory per process.
FEATURE_FLAGS_CACHE_TTL_MS=5000

# ---------------------------------------------------------------------------
# Worker (apps/server, src/worker.ts)
# ---------------------------------------------------------------------------
# Jobs processed in parallel per queue.
WORKER_CONCURRENCY=5
# Interval (ms) for the maintenance heartbeat job.
HEARTBEAT_INTERVAL_MS=60000

# ---------------------------------------------------------------------------
# Web (apps/web)
# ---------------------------------------------------------------------------
# Public URL of the API as seen from the browser.
NEXT_PUBLIC_API_URL=http://localhost:4000
