# Meeting Hub — environment variables.
# Copy to `.env` at the repo root: `cp .env.example .env`.
# Every value below is a LOCAL DEVELOPMENT default that matches infra/docker-compose.yml.
# Never commit a real .env; production values come from the deployment's secret store.

# ---------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------
# development | test | production. Controls pretty logs, OpenAPI exposure, error detail.
NODE_ENV=development
# pino level: fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# ---------------------------------------------------------------------------
# API server (apps/server, src/api.ts)
# ---------------------------------------------------------------------------
# Interface and port the API listens on.
API_HOST=0.0.0.0
API_PORT=4000
# Single browser origin allowed by CORS (the Next.js app).
WEB_ORIGIN=http://localhost:3000
# Max time (ms) to drain in-flight requests / jobs on SIGTERM before forcing exit.
SHUTDOWN_TIMEOUT_MS=10000

# ---------------------------------------------------------------------------
# PostgreSQL (with pgvector)
# ---------------------------------------------------------------------------
DATABASE_URL=postgres://meeting_hub:meeting_hub@localhost:5432/meeting_hub
# Max connections in each process's pool.
DATABASE_POOL_MAX=10

# ---------------------------------------------------------------------------
# Redis (BullMQ)
# ---------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379

# ---------------------------------------------------------------------------
# S3-compatible object storage (Garage locally)
# ---------------------------------------------------------------------------
S3_ENDPOINT=http://localhost:3900
S3_REGION=garage
S3_BUCKET=meeting-hub-dev
# Dev-only key imported into the local Garage by infra/garage/init.sh.
S3_ACCESS_KEY_ID=GK0123456789abcdef01234567
S3_SECRET_ACCESS_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
# Path-style URLs (http://host/bucket/key) — required for Garage and most self-hosted S3.
S3_FORCE_PATH_STYLE=true
# Endpoint used in presigned upload/download URLs. Browsers upload straight to it, so it must be
# reachable from them (and the bucket's CORS must allow WEB_ORIGIN). Empty = S3_ENDPOINT.
S3_PUBLIC_ENDPOINT=

# ---------------------------------------------------------------------------
# Recording uploads (browser → S3 multipart, ADR 0003)
# ---------------------------------------------------------------------------
# Multipart part size in bytes (>= 5 MiB, the S3 minimum). 16 MiB.
UPLOAD_PART_SIZE_BYTES=16777216
# Lifetime of presigned part URLs, in seconds. Clients fetch fresh ones in batches.
UPLOAD_URL_TTL_SECONDS=900
# Part URLs returned per batch (the start response and each /parts call).
UPLOAD_URL_BATCH_SIZE=10
# Largest recording accepted, in bytes. 2 GiB.
MAX_UPLOAD_BYTES=2147483648
# Multipart uploads older than this are aborted by the hourly media.abort-stale-uploads job.
UPLOAD_STALE_AFTER_HOURS=24
# Lifetime of signed download URLs for original recordings, in seconds.
DOWNLOAD_URL_TTL_SECONDS=300

# ---------------------------------------------------------------------------
# Feature flags
# ---------------------------------------------------------------------------
# Comma-separated overrides that win over the database, e.g. "flag.a=true,flag.b=false".
FEATURE_FLAGS_OVERRIDE=
# How long (ms) flags read from the database are cached in memory per process.
FEATURE_FLAGS_CACHE_TTL_MS=5000

# ---------------------------------------------------------------------------
# Worker (apps/server, src/worker.ts)
# ---------------------------------------------------------------------------
# Jobs processed in parallel per queue.
WORKER_CONCURRENCY=5
# Interval (ms) for the maintenance heartbeat job.
HEARTBEAT_INTERVAL_MS=60000

# ---------------------------------------------------------------------------
# Processing pipeline and media preparation (worker, ADR 0004)
# ---------------------------------------------------------------------------
# ffmpeg / ffprobe binaries. Default: found on PATH (see README for installing on Windows).
FFMPEG_PATH=
FFPROBE_PATH=
# Threads per ffmpeg process.
FFMPEG_THREADS=2
# prepare_media jobs run in parallel per worker. Empty = number of CPUs.
MEDIA_CONCURRENCY=
# Where per-job temp directories go (always removed afterwards). Empty = the OS temp directory.
MEDIA_TMP_DIR=
# Recordings longer than this (seconds) fail with MEDIA_TOO_LONG. 3 hours.
MAX_DURATION_SECONDS=10800
# Lifetime of signed URLs for the normalized audio and waveform peaks, in seconds.
MEDIA_URL_TTL_SECONDS=900
# How often (ms) the worker polls the domain_events outbox.
OUTBOX_POLL_INTERVAL_MS=1000
# How often (ms) the sweeper repairs runs whose queued work went missing.
PROCESSING_SWEEP_INTERVAL_MS=60000
# Interval (ms) between heartbeat comments on the live progress stream (SSE).
SSE_HEARTBEAT_MS=15000

# ---------------------------------------------------------------------------
# Authentication (Better Auth, mounted on the API at /api/auth/*)
# ---------------------------------------------------------------------------
# Signs session cookies and tokens. >= 32 chars. Generate with: openssl rand -base64 32
# LOCAL DEV ONLY — production uses a secret from the secret store.
BETTER_AUTH_SECRET=dev-only-better-auth-secret-change-me-0123456789
# Public origin the browser uses (the web app, which proxies /api/auth/* and /v1/* to the API).
BETTER_AUTH_URL=http://localhost:3000
# Google OAuth (optional). Also requires the auth.google_signin feature flag.
# Redirect URI to register: <BETTER_AUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Rate limits on sign-in/up, password reset and invitations (Redis-backed). Disable only in tests.
RATE_LIMIT_ENABLED=true
# Proxies in front of the API whose X-Forwarded-For entries are trusted for the client IP.
# 1 = the web app only. Never expose the API directly to the internet.
TRUST_PROXY_HOPS=1

# ---------------------------------------------------------------------------
# Email (SMTP; Mailpit locally — inbox at http://localhost:8025)
# ---------------------------------------------------------------------------
SMTP_HOST=localhost
SMTP_PORT=1025
# true = implicit TLS (port 465). Mailpit is plain SMTP.
SMTP_SECURE=false
# Optional SMTP credentials.
SMTP_USER=
SMTP_PASSWORD=
# From address on every email.
MAIL_FROM=Meeting Hub <no-reply@meeting-hub.local>

# ---------------------------------------------------------------------------
# Web (apps/web)
# ---------------------------------------------------------------------------
# Where the Next.js server proxies /api/auth/* and /v1/* (and makes server-side API calls).
# The browser never calls the API directly. Baked into the Next.js build (rewrites).
API_INTERNAL_URL=http://localhost:4000
