{
  "name": "@meeting-hub/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --port 3000",
    "build": "next build",
    "start": "next start --port 3000",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "api:generate": "openapi-typescript ../../packages/contracts/openapi.json -o src/lib/api/schema.d.ts",
    "test:e2e": "playwright test",
    "format": "prettier --write . --ignore-path ../../.prettierignore --ignore-path ../../.gitignore",
    "format:check": "prettier --check . --ignore-path ../../.prettierignore --ignore-path ../../.gitignore"
  },
  "dependencies": {
    "@base-ui/react": "1.8.0",
    "@meeting-hub/contracts": "workspace:*",
    "better-auth": "1.7.7",
    "class-variance-authority": "0.7.1",
    "cn": "0.4.0",
    "lucide-react": "1.49.0",
    "next": "16.3.8",
    "openapi-fetch": "0.17.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "shadcn": "4.21.1",
    "sonner": "2.0.8",
    "tw-animate-css": "1.4.0"
  },
  "devDependencies": {
    "@meeting-hub/config": "workspace:*",
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.19.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "10.11.0",
    "eslint-config-next": "16.3.8",
    "globals": "17.13.0",
    "openapi-typescript": "7.13.0",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vitest": "5.0.3"
  }
}
