{
  "name": "@meeting-hub/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,worker -c blue,magenta \"pnpm dev:api\" \"pnpm dev:worker\"",
    "dev:api": "tsx watch --clear-screen=false src/api.ts",
    "dev:worker": "tsx watch --clear-screen=false src/worker.ts",
    "build": "tsup",
    "start:api": "node dist/api.js",
    "start:worker": "node dist/worker.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "openapi:export": "tsx scripts/export-openapi.ts",
    "start:migrate": "node dist/migrate.js",
    "auth:schema": "auth generate --config scripts/auth-cli.ts --output .auth-schema.generated.ts --yes",
    "format": "prettier --write . --ignore-path ../../.prettierignore --ignore-path ../../.gitignore",
    "format:check": "prettier --check . --ignore-path ../../.prettierignore --ignore-path ../../.gitignore"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1145.0",
    "@aws-sdk/lib-storage": "3.1145.0",
    "@aws-sdk/s3-request-presigner": "3.1145.0",
    "@fastify/cors": "11.3.0",
    "@fastify/rate-limit": "11.2.0",
    "@fastify/swagger": "9.9.1",
    "@meeting-hub/contracts": "workspace:*",
    "@meeting-hub/db": "workspace:*",
    "better-auth": "1.7.7",
    "bullmq": "6.3.11",
    "drizzle-orm": "0.45.3",
    "fastify": "5.12.5",
    "fastify-type-provider-zod": "7.0.0",
    "ioredis": "6.0.0",
    "nodemailer": "10.0.13",
    "pg": "8.23.1",
    "pino": "10.3.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@meeting-hub/config": "workspace:*",
    "@testcontainers/postgresql": "12.2.0",
    "@testcontainers/redis": "12.2.0",
    "@types/node": "24.19.1",
    "@types/nodemailer": "8.0.2",
    "auth": "1.7.7",
    "concurrently": "10.0.5",
    "eslint": "10.11.0",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-boundaries": "7.2.0",
    "pino-pretty": "13.1.3",
    "testcontainers": "12.2.0",
    "tsup": "8.5.1",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.0.3"
  }
}
